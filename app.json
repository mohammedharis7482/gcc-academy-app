{
  "expo": {
    "name": "GCC Football Academy",
    "slug": "gcc-football-academy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#F4F6F8",
    "scheme": "gccacademyapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "ios": {
      "bundleIdentifier": "com.mhdharis.gccacademyapp",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/images/ios-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.mhd_haris.gccacademyapp",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.READ_CALL_LOG",
        "android.permission.WRITE_CALL_LOG",
        "android.permission.QUERY_ALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#081D4D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "androidStatusBar": {
      "backgroundColor": "#F4F6F8",
      "barStyle": "dark-content"
    },

    "androidNavigationBar": {
      "backgroundColor": "#F4F6F8",
      "barStyle": "dark-content"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6F8"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "74eda49e-15b9-4a94-a450-03bc88c3b593"
      }
    }
  }
}
